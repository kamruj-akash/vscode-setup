{
  // 🎨 Theme Customization
  "workbench.colorCustomizations": {
    "[Learn with Sumit - Professional]": {
      "toolbar.activeBackground": "#80CBC426",
      "activityBarBadge.background": "#80CBC4",
      "activityBar.activeBorder": "#80CBC4"
      // ... (other UI colors)
    },
    // Terminal Theme Customization
    "terminal.background": "#131a19",
    "terminal.foreground": "#9ba9e3",
    "terminal.integrated.fontFamily": "FiraCode Nerd Font"
    // ... (other terminal colors)
  },

  // ⚙️ General Editor & Explorer Settings
  "workbench.editor.empty.hint": "hidden",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "afterDelay",
  "editor.renderWhitespace": "none",
  "editor.guides.indentation": false,

  // 🔐 Security Settings
  "security.workspace.trust.untrustedFiles": "open",

  // ✍️ Editor Appearance =>
  "editor.fontSize": 18,
  "editor.lineHeight": 28,
  "editor.wordWrap": "on",
  "editor.smoothScrolling": true,
  "editor.fontFamily": "AkashCode",

  "editor.fontLigatures": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "entity.name.type",
          "storage.type",
          "support.type",
          "support.class",
          "entity.name.class",
          "entity.other.inherited-class"
        ],
        "settings": {
          "fontStyle": ""
        }
      },
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },

  // 🧠 Better visuals
  "editor.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,

  // 💡 Suggestion Priority (snippet age, AI ghost text pore)
  // snippet gulo suggestion list-er sobar upore boshbe (clg, clog etc.)
  "editor.snippetSuggestions": "top",
  // list-er prothom item-i select thakbe — "recently used" onno kichu upore tulbe na
  "editor.suggestSelection": "first",
  // kachhakachhi declare kora variable-ke extra weight deya bondho
  "editor.suggest.localityBonus": false,
  // Tab chaple snippet expand hobe
  "editor.tabCompletion": "on",
  // ghost text thakleo suggest widget luka jabe na — dutoi dekhabe
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": false,
  "editor.acceptSuggestionOnEnter": "on",

  // 🖱️ Cursor Customization
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",

  // 🧑‍💻 Code Formatting & Linting (ESLint + Prettier)
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // ESLint-
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  // 🔲 Terminal Font Size & Line Height
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.lineHeight": 1.3,

  // 🧭 Sidebar Config
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.startupEditor": "none",
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.env.osx": {},
  "workbench.externalBrowser": "chrome",
  "workbench.sideBar.location": "right",
  "workbench.activityBar.iconClickBehavior": "focus",

  // 🎥 Screencast Mode Customization
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/kb/th4cqwvd2nb473n0mnz5r7qm0000gn/T/postman-http-request-pre-request.instructions.md": true
  },
  "cSpell.userWords": [
    "akas",
    "akash",
    "Bangla",
    "Commerz",
    "cuid",
    "farzana",
    "folbon",
    "formatjs",
    "IELTS",
    "isactive",
    "Kamruj",
    "kamruzzaman",
    "localematcher",
    "mithila",
    "moneymate",
    "neondatabase",
    "neondb",
    "oni",
    "Pressable",
    "sslmode",
    "summarised",
    "SUPABASE",
    "Swal",
    "sweetalert",
    "Topbar"
  ],
  "files.autoSaveDelay": 2000,
  // "terminal.integrated.fontFamily": "MesloLGL Nerd Font",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "timeline.pageSize": 40,
  "workbench.colorTheme": "Learn with Sumit - Peace of the eye",
  // "typescript.updateImportsOnFileMove.enabled": "always",
  "git.enableSmartCommit": true,
  "http.systemCertificatesNode": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.ignoreRebaseWarning": true,
  "diffEditor.codeLens": true,
  "workbench.productIconTheme": "icons-octicons",
  "explorer.confirmPasteNative": false,
  "editor.minimap.size": "fill",
  "editor.minimap.enabled": false,
  "editor.unicodeHighlight.allowedLocales": {
    "cs": true
  },
  "workbench.activityBar.location": "top",
  // "typescript.experimental.useTsgo": true,
  "workbench.iconTheme": "material-icon-theme",
  "terminal.integrated.fontFamily": "monospace",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "prisma": false,
    "typescript": true,
    "typescriptreact": true
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "github.copilot.nextEditSuggestions.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "continue.enableNextEdit": false,
  "chat.disableAIFeatures": true,
  "continue.enableTabAutocomplete": false
}
